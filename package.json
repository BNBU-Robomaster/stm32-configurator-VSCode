{
  "name": "stm32-flash-configurator",
  "displayName": "STM32 Flash Configurator",
  "description": "Visual STM32 configuration: F5 debugging, Ctrl+F5 build, program, verify and run. Based on 左岚’s STM32 Debug Configurator.",
  "version": "1.1.0",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "icon": "icon.png",
  "author": "左岚",
  "publisher": "sarzn",
  "repository": {
    "type": "git",
    "url": "https://github.com/BNBU-Robomaster/stm32-configurator-VSCode.git"
  },
  "activationEvents": [
    "onCommand:stm32-flash-configurator.start",
    "onCommand:stm32-flash-configurator.autoConfigureAll",
    "onCommand:stm32-flash-configurator.oneClickSetup",
    "onCommand:stm32-flash-configurator.intelligentWizard",
    "onCommand:stm32-flash-configurator.healthCheck",
    "onView:stm32-flash-configurator-explorer",
    "onDebugResolve:cortex-debug"
  ],
  "extensionDependencies": [
    "marus25.cortex-debug"
  ],
  "extensionRecommendations": [
    "marus25.cortex-debug",
    "ms-vscode.cmake-tools"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stm32-flash-configurator-explorer",
          "title": "STM32 Flash Configurator",
          "icon": "$(chip)"
        }
      ]
    },
    "views": {
      "stm32-flash-configurator-explorer": [
        {
          "id": "stm32-flash-configurator-tree",
          "name": "Debug Configuration",
          "when": "true",
          "contextualTitle": "STM32 Debug Configuration"
        }
      ]
    },
    "commands": [
      {
        "command": "stm32-flash-configurator.start",
        "title": "生成调试与烧录配置 / Generate Debug and Flash Configuration",
        "category": "STM32",
        "icon": "$(gear)"
      },
      {
        "command": "stm32-flash-configurator.refresh",
        "title": "Refresh",
        "category": "STM32",
        "icon": "$(refresh)"
      },
      {
        "command": "stm32-flash-configurator.openConfig",
        "title": "Open Configuration",
        "category": "STM32",
        "icon": "$(file)"
      },
      {
        "command": "stm32-flash-configurator.addLiveWatchVariable",
        "title": "Add LiveWatch Variable",
        "category": "STM32",
        "icon": "$(add)"
      },
      {
        "command": "stm32-flash-configurator.removeLiveWatchVariable",
        "title": "Remove LiveWatch Variable",
        "category": "STM32",
        "icon": "$(remove)"
      },
      {
        "command": "stm32-flash-configurator.toggleLanguage",
        "title": "Toggle Language (中文/English)",
        "category": "STM32",
        "icon": "$(globe)"
      },
      {
        "command": "stm32-flash-configurator.detectToolchain",
        "title": "Detect ARM Toolchain",
        "category": "STM32",
        "icon": "$(search)"
      },
      {
        "command": "stm32-flash-configurator.setupToolchain",
        "title": "Setup Toolchain",
        "category": "STM32",
        "icon": "$(tools)"
      },
      {
        "command": "stm32-flash-configurator.autoConfigureAll",
        "title": "Auto-Configure All",
        "category": "STM32 Auto-Config",
        "icon": "$(wand)"
      },
      {
        "command": "stm32-flash-configurator.oneClickSetup",
        "title": "One-Click Setup",
        "category": "STM32 Auto-Config",
        "icon": "$(rocket)"
      },
      {
        "command": "stm32-flash-configurator.intelligentWizard",
        "title": "Intelligent Configuration Wizard",
        "category": "STM32 Auto-Config",
        "icon": "$(lightbulb-autofix)"
      },
      {
        "command": "stm32-flash-configurator.autoTroubleshoot",
        "title": "Auto-Troubleshoot Configuration",
        "category": "STM32 Auto-Config",
        "icon": "$(wrench)"
      },
      {
        "command": "stm32-flash-configurator.healthCheck",
        "title": "Environment Health Check",
        "category": "STM32 Auto-Config",
        "icon": "$(pulse)"
      },
      {
        "command": "stm32-flash-configurator.flash",
        "title": "编译并烧录 / Build and Flash",
        "category": "STM32",
        "icon": "$(cloud-upload)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stm32-flash-configurator.start",
          "when": "view == stm32-flash-configurator-tree",
          "group": "navigation@1"
        },
        {
          "command": "stm32-flash-configurator.refresh",
          "when": "view == stm32-flash-configurator-tree",
          "group": "navigation@2"
        },
        {
          "command": "stm32-flash-configurator.setupToolchain",
          "when": "view == stm32-flash-configurator-tree",
          "group": "navigation@3"
        },
        {
          "command": "stm32-flash-configurator.oneClickSetup",
          "when": "view == stm32-flash-configurator-tree",
          "group": "auto-config@1"
        },
        {
          "command": "stm32-flash-configurator.autoConfigureAll",
          "when": "view == stm32-flash-configurator-tree",
          "group": "auto-config@2"
        },
        {
          "command": "stm32-flash-configurator.healthCheck",
          "when": "view == stm32-flash-configurator-tree",
          "group": "auto-config@3"
        },
        {
          "command": "stm32-flash-configurator.flash",
          "when": "view == stm32-flash-configurator-tree",
          "group": "navigation@0"
        }
      ],
      "view/item/context": [
        {
          "command": "stm32-flash-configurator.openConfig",
          "when": "view == stm32-flash-configurator-tree && viewItem == configuration",
          "group": "inline"
        }
      ],
      "commandPalette": [
        {
          "command": "stm32-flash-configurator.addLiveWatchVariable",
          "when": "debugType == cortex-debug"
        },
        {
          "command": "stm32-flash-configurator.removeLiveWatchVariable",
          "when": "debugType == cortex-debug"
        },
        {
          "command": "stm32-flash-configurator.toggleLanguage"
        },
        {
          "command": "stm32-flash-configurator.detectToolchain"
        },
        {
          "command": "stm32-flash-configurator.setupToolchain"
        },
        {
          "command": "stm32-flash-configurator.autoConfigureAll"
        },
        {
          "command": "stm32-flash-configurator.oneClickSetup"
        },
        {
          "command": "stm32-flash-configurator.intelligentWizard"
        },
        {
          "command": "stm32-flash-configurator.autoTroubleshoot"
        },
        {
          "command": "stm32-flash-configurator.healthCheck"
        }
      ]
    },
    "configuration": {
      "title": "STM32 Configurator",
      "properties": {
        "stm32-flash-configurator.openocdPath": {
          "type": "string",
          "default": "",
          "description": "Custom path to OpenOCD executable. Leave empty for automatic detection.",
          "scope": "resource"
        },
        "stm32-flash-configurator.language": {
          "type": "string",
          "enum": [
            "zh",
            "en"
          ],
          "default": "zh",
          "description": "Extension display language (中文/English) — 默认中文，英文 VS Code 自动切换为英文",
          "scope": "application"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./ && copyfiles -u 1 \"src/webview/**/*\" out/",
    "watch": "node scripts/watch-all.js",
    "watch:tsc-only": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "node --test tests/flash-*.test.cjs",
    "test:unit": "npm run compile && mocha ./out/test/openocd-browser.test.js",
    "test:integration": "npm run compile && mocha ./out/test/webview-integration.test.js",
    "test:platform": "npm run compile && mocha ./out/test/cross-platform.test.js",
    "test:toolchain": "npm run compile && mocha \"./out/test/{toolchain-workflow,extension-activation,ui-components,internationalization,configuration-management}.test.js\" --timeout 10000",
    "test:workflow": "npm run compile && mocha ./out/test/toolchain-workflow.test.js --timeout 10000",
    "test:ui": "npm run compile && mocha ./out/test/ui-components.test.js --timeout 5000",
    "test:i18n": "npm run compile && mocha ./out/test/internationalization.test.js --timeout 5000",
    "test:config": "npm run compile && mocha ./out/test/configuration-management.test.js --timeout 5000",
    "test:extension": "npm run compile && mocha ./out/test/extension-activation.test.js --timeout 5000",
    "test:all": "npm run test:unit && npm run test:integration && npm run test:platform && npm run test:toolchain",
    "test:watch": "npm run compile && mocha ./out/test/**/*.test.js --watch",
    "test:coverage": "nyc npm run test:all",
    "test:device": "npm run compile && node scripts/test-device-detector.js",
    "test:arm": "npm run compile && node scripts/test-arm-toolchain.js",
    "test:target": "node scripts/test-target-inference.js",
    "test:exec": "npm run compile && node scripts/test-executable-detector.js",
    "test:flash": "npm run compile && node --test tests/flash-*.test.cjs",
    "package": "vsce package",
    "test:host": "npm run compile && node tests/run-host.cjs",
    "test:legacy": "npm run compile && node scripts/test-device-detector.js && node scripts/test-target-inference.js && node scripts/test-arm-toolchain.js && node scripts/test-executable-detector.js"
  },
  "devDependencies": {
    "@types/jsdom": "^21.1.6",
    "@types/mocha": "^10.0.1",
    "@types/node": "^18.15.0",
    "@types/sinon": "^17.0.4",
    "@types/vscode": "^1.80.0",
    "@typescript-eslint/eslint-plugin": "^5.59.1",
    "@typescript-eslint/parser": "^5.59.1",
    "@vscode/test-electron": "^2.3.2",
    "@vscode/vsce": "^4.1.1",
    "copyfiles": "^2.4.1",
    "eslint": "^8.39.0",
    "glob": "^8.1.0",
    "jsdom": "^24.0.0",
    "mocha": "^10.2.0",
    "nyc": "^15.1.0",
    "sinon": "^17.0.1",
    "typescript": "^5.0.4"
  },
  "dependencies": {
    "jsonc-parser": "^3.3.1"
  },
  "license": "MIT",
  "contributors": [
    {
      "name": "sarzn"
    }
  ]
}
